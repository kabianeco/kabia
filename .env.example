# Public Supabase credentials — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# The single configured site URL: canonical, OG, sitemap, structured data,
# robots and auth redirects all derive from this. Production target is
# kabiaekolojik.com; point it at the Vercel URL only before the DNS cutover.
NEXT_PUBLIC_SITE_URL=https://kabiaekolojik.com

# ---------------------------------------------------------------------------
# Server-only. Never prefix any of these with NEXT_PUBLIC_ — that would ship
# them in the browser bundle.
# ---------------------------------------------------------------------------

# Supabase service-role (secret) key. Required only for Auth Admin operations:
# creating the bootstrap administrator, creating administrators, and reading
# auth-only fields such as email and last sign-in. The dashboard's ordinary
# reads and writes use the signed-in administrator's own session and RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase secret API key (sb_secret_...) for server-side Auth with
# Sb-Forwarded-For IP forwarding (lib/supabase/server.ts). Without it the
# server uses the anon key and every customer shares Vercel's egress IPs for
# Supabase's per-IP /token limit. Enable "IP Address Forwarding" in
# Supabase Dashboard > Authentication > Rate Limits, then set this in Vercel
# env. Legacy anon/service_role keys are ignored for forwarding by Supabase.
SUPABASE_SECRET_KEY=

# The admin sign-in alias. `admin` is resolved to ADMIN_BOOTSTRAP_EMAIL on the
# server only; there is no public username-to-email lookup.
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_EMAIL=admin@kabia.local

# Optional. Only read by scripts/bootstrap-admin.ts, and only honoured when
# NODE_ENV=production, where it must be at least 12 characters. Leave unset in
# development — the script generates a secure password if the requested weak one
# is rejected by the Supabase password policy.
ADMIN_BOOTSTRAP_PASSWORD=

# Dedicated salt for rate-limit key hashing (lib/auth/rate-limit.ts).
# REQUIRED in production: the limiter fails closed when unset. Generate with:
#   openssl rand -hex 32
RATE_LIMIT_SALT=

# Resend (transactional e-posta gönderimi — lib/email/send.ts).
# Yönetici parola sıfırlama bildirimi bu anahtarla gönderilir. Eksikse
# gönderim denenmez ve işlem uyarıyla tamamlanır; parola ve oturum
# işlemleri yine de uygulanır.
# Üretimde zorunlu: https://resend.com/api-keys adresinden alın.
RESEND_API_KEY=
# Doğrulanmış gönderici adresi. Örn: Kabia <noreply@kabiaekolojik.com>
# Boşsa Resend test adresi kullanılır (yalnızca hesap sahibine gider).
RESEND_FROM=

# Resend alım (receiving) webhook imza sırrı. Resend panelinde webhook
# oluşturulunca görünür (whsec_... ile başlar); gövde doğrulaması için
# zorunludur. Üretimde Vercel'e aynen ekleyin.
RESEND_INBOUND_WEBHOOK_SECRET=

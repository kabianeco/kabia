# Public Supabase credentials — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Server-only. Never prefix any of these with NEXT_PUBLIC_ — that would ship
# them in the browser bundle.
# ---------------------------------------------------------------------------

# Supabase service-role (secret) key. Required only for Auth Admin operations:
# creating the bootstrap administrator, creating administrators, and reading
# auth-only fields such as email and last sign-in. The dashboard's ordinary
# reads and writes use the signed-in administrator's own session and RLS.
SUPABASE_SERVICE_ROLE_KEY=

# The admin sign-in alias. `admin` is resolved to ADMIN_BOOTSTRAP_EMAIL on the
# server only; there is no public username-to-email lookup.
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_EMAIL=admin@kabia.local

# Optional. Only read by scripts/bootstrap-admin.ts, and only honoured when
# NODE_ENV=production, where it must be at least 12 characters. Leave unset in
# development — the script generates a secure password if the requested weak one
# is rejected by the Supabase password policy.
ADMIN_BOOTSTRAP_PASSWORD=

{
  "name": "kabia-latest",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname localhost",
    "dev:webpack": "next dev --webpack --hostname localhost",
    "dev:lan": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --test --conditions=react-server --import ./tests/alias-hook.mjs \"tests/**/*.test.js\" \"tests/**/*.test.ts\"",
    "test:affected-routes": "node --env-file=.env.local ./node_modules/@playwright/test/cli.js test tests/affected-routes.production.spec.ts",
    "test:dev-stability": "node --env-file=.env.local ./node_modules/@playwright/test/cli.js test --config playwright.dev.config.ts",
    "test:dev-stability:webpack": "DEV_BUNDLER=webpack node --env-file=.env.local ./node_modules/@playwright/test/cli.js test --config playwright.dev.config.ts",
    "test:role-revocation": "node --test --conditions=react-server --import ./tests/alias-hook.mjs --env-file=.env.local tests/role-revocation.test.js",
    "admin:bootstrap": "node --env-file=.env.local scripts/bootstrap-admin.ts"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.111.0",
    "@tiptap/core": "^3.29.2",
    "@tiptap/extension-character-count": "^3.29.2",
    "@tiptap/extension-image": "^3.29.2",
    "@tiptap/extension-link": "^3.29.2",
    "@tiptap/extension-placeholder": "^3.29.2",
    "@tiptap/pm": "^3.29.2",
    "@tiptap/react": "^3.29.2",
    "@tiptap/starter-kit": "^3.29.2",
    "clsx": "^2.1.1",
    "framer-motion": "^12.43.0",
    "lucide-react": "^1.28.0",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "three": "^0.185.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "sharp": "^0.35.0",
    "postcss": "^8.5.18"
  },
  "allowScripts": {
    "sharp@0.35.3": true,
    "unrs-resolver@1.12.2": true
  }
}
